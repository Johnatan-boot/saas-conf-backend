{
  "name": "saas-confeitaria-backend",
  "version": "2.0.0",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/core/server.ts",
    "build": "tsc && npm run copy-migrations",
    "copy-migrations": "node -e \"const fs=require('fs'),path=require('path');const src=path.join('src','database','migrations');const dest=path.join('dist','database','migrations');fs.mkdirSync(dest,{recursive:true});fs.readdirSync(src).forEach(f=>fs.copyFileSync(path.join(src,f),path.join(dest,f)));console.log('✅ Migrations copiadas')\"",
    "start": "node dist/core/server.js",
    "seed": "node dist/database/runSeed.js",
    "migrate": "node -e \"require('./dist/database/migrate').runMigrations().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/jwt": "^7.2.4",
    "@fastify/rate-limit": "^9.1.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.8.5",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8",
    "stripe": "^14.25.0",
    "mercadopago": "^2.0.6"

  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.37",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
