PORT=3000
PORT=3000
NODE_ENV=production

# ── Banco de dados (Clever Cloud) ─────────────────────────────────────────
DB_HOST=seu-host.mysql.cleverapps.io
DB_PORT=3306
DB_USER=seu_usuario
DB_PASS=sua_senha
DB_NAME=seu_banco
DB_SSL=true

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=gere_uma_chave_segura_de_32_caracteres_aqui
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ── URLs ──────────────────────────────────────────────────────────────────
FRONTEND_URL=https://saas-conf-frontends.onrender.com

# ── Integrações (opcionais) ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=
ZAPIER_WEBHOOK_URL=
